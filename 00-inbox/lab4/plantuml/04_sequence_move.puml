@startuml
skinparam DefaultFontName DejaVu Sans
skinparam shadowing false
title UC-06 — Ручной перенос занятия
actor "Диспетчер" as D
boundary "ui:ScheduleUI" as UI
control "service:ScheduleService" as S
control "checker:ConstraintChecker" as C
entity "version:ScheduleVersion" as V
entity "lesson:Lesson" as L
D -> UI : requestMove(lessonId, slotId, roomId)
UI -> S : moveLesson(lessonId, slotId, roomId)
activate S
alt изменяется опубликованная версия
  S -> V : cloneAsDraft()
  V --> S : draftVersion
else существует редактируемый проект
  note over S,V : Редактируем только черновик
end
S -> C : validateLesson(candidate, V)
C --> S : conflicts
alt допустимый перенос
  S -> V : updateLesson(lessonId, slotId, roomId)
  V -> L : reschedule(slot, room)
  S -> V : setStatus("Проверка")
  S -> C : validateVersion(V)
  C --> S : conflicts
  alt вся версия корректна
    S -> C : calculateGaps(V)
    C --> S : newGapsScore
    S -> V : setStatus("Готово")
    S --> UI : moveAccepted(newGapsScore)
  else обнаружены иные ошибки
    V -> L : reschedule(previousSlot, previousRoom)
    S -> V : setStatus("Черновик")
    S --> UI : moveRejected(conflicts)
  end
else конфликт ресурсов / недоступность
  S --> UI : moveRejected(conflicts)
  UI -> D : showConflicts(conflicts)
end
UI -> D : showSchedule(V.id)
note over C,V : ПТ-05, О-01..О-04, АК-04
 deactivate S
@enduml
