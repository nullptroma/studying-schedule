@startuml
skinparam DefaultFontName DejaVu Sans
skinparam shadowing false
skinparam componentStyle uml2
title Компонентная архитектура ИС «Учебное расписание»
package "Клиент" {
  component "Веб-интерфейс\n[ScheduleUI]" as UI
}
package "Сервер приложения" {
  component "API и контроль доступа\n[User, Dispatcher, Teacher]" as Access
  component "Каталог ресурсов\n[StudentGroup, Classroom,\nTeachingAssignment, TimeSlot]" as Catalog
  component "Планировщик\n[ScheduleService]" as Solver
  component "Проверка ограничений\n[ConstraintChecker]" as Checker
  component "Хранилище версий\n[ScheduleVersion, Lesson]" as Storage
  component "Экспорт/интеграция" as Export
}
cloud "Внешняя учебная ИС" as Ext
interface "IPlanningApi" as IPlan
interface "IConstraints" as ICons
interface "IScheduleStore" as IStore
interface "IExport" as IExport
UI ..> IPlan : требует
Access - IPlan : предоставляет
Access ..> Solver : вызывает
Access ..> Catalog : справочники
Solver ..> ICons : требует
Checker - ICons : предоставляет
Solver ..> IStore : требует
Storage - IStore : предоставляет
Checker ..> Catalog : данные ресурсов
Export ..> IStore : читает
Export - IExport : предоставляет
Ext ..> IExport : требует
note bottom of Solver
  БТ-01, БТ-02; планирование
  с учётом жёстких ограничений
end note
@enduml
